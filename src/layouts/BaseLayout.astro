---
import '../styles/global.css';
import Header from '../components/ui/Header.astro';
import Sidebar from '../components/ui/Sidebar.astro';
import { getGlobalStats } from '../lib/supabase';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  author?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description = '狂小說網・通勤文學速讀 — 極簡閱讀，通勤時間的文學宇宙',
  ogImage,
  canonicalURL,
  type = 'website',
  publishDate,
  author,
  keywords = [],
  noindex = false,
} = Astro.props;

const siteURL = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const canonical = canonicalURL ?? Astro.url.href;
// Fallback OG image — always an absolute URL
const ogImg = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteURL}${ogImage}`)
  : `https://picsum.photos/seed/mrtnovels-og/1200/630`;

const defaultKW = ['短篇小說', '台灣文學', '通勤文學', '短篇故事', '捷運'];
const allKW = [...new Set([...defaultKW, ...keywords])].join(', ');

let globalStats = { views: 0, likes: 0 };
try { globalStats = await getGlobalStats(); } catch {}

const fullTitle = title === '狂小說網' ? title + '・通勤文學速讀' : `${title} — 狂小說網`;
---
<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={allKW} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow'} />
  <meta name="author" content={author ?? '狂小說網'} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:site_name" content="狂小說網" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />

  {type === 'article' && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()} />
  )}
  {type === 'article' && author && (
    <meta property="article:author" content={author} />
  )}

  <!-- JSON-LD -->
  {type === 'article' ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": ogImg,
      "keywords": allKW,
      "inLanguage": "zh-TW",
      "author": { "@type": "Person", "name": author ?? '站長' },
      "publisher": {
        "@type": "Organization",
        "name": "狂小說網",
        "url": siteURL,
        "logo": { "@type": "ImageObject", "url": `${siteURL}/favicon.svg` },
      },
      "datePublished": publishDate?.toISOString(),
      "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
    })} />
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "狂小說網・通勤文學速讀",
      "url": siteURL,
      "description": description,
      "inLanguage": "zh-TW",
      "potentialAction": {
        "@type": "SearchAction",
        "target": { "@type": "EntryPoint", "urlTemplate": `${siteURL}/stories?q={search_term_string}` },
        "query-input": "required name=search_term_string",
      },
    })} />
  )}

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Anti-flash: apply theme/font/size BEFORE first paint -->
  <script>
    (function(){
      var h=document.documentElement;
      // Theme
      var t=localStorage.getItem('ks-theme')||'system';
      if(t==='dark')h.classList.add('dark');
      else if(t==='light')h.classList.remove('dark');
      else if(window.matchMedia('(prefers-color-scheme: dark)').matches)h.classList.add('dark');
      // Font & size: inject <style> so it works before body renders
      var fontMap={'serif':"'Noto Serif TC','Songti SC','PMingLiU','新細明體',Georgia,serif",'cursive':"'LXGW WenKai TC','DFKai-SB','標楷體',BiauKai,cursive,serif",'system':"system-ui,-apple-system,sans-serif"};
      var sizeMap={'sm':'87.5%','lg':'112.5%'};
      var f=localStorage.getItem('ks-font')||'sans';
      var s=localStorage.getItem('ks-size')||'md';
      var r=localStorage.getItem('ks-highlight-red')==='true';
      var css='';
      if(fontMap[f])css+='body{font-family:'+fontMap[f]+'!important}';
      if(sizeMap[s])css+='html{font-size:'+sizeMap[s]+'!important}';
      if(r)css+='.story-body strong,.story-body b{color:#e53935;font-weight:500}';
      if(css){var st=document.createElement('style');st.textContent=css;document.head.appendChild(st);}
    })();
  </script>

  <!-- Google Fonts: 黑體(Noto Sans TC) + 明體(Noto Serif TC) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@400;500;700&display=swap" rel="stylesheet" />
  <!-- 霞鶩文楷 TC：只在楷體模式或初次進入時預載（避免 28MB 無謂載入） -->
  <script>
    (function(){
      var f = localStorage.getItem('ks-font');
      if (f === 'cursive') {
        var l = document.createElement('link');
        l.rel = 'stylesheet';
        l.href = 'https://cdn.jsdelivr.net/npm/lxgw-wenkai-tc-web@1.522.0/style.css';
        document.head.appendChild(l);
      }
    })();
  </script>
</head>
<body>
  <Header />
  <div class="sidebar-overlay" id="sidebar-overlay"></div>
  <Sidebar views={globalStats.views} likes={globalStats.likes} />

  <main class="main-wrap">
    <slot />
  </main>

  <script>
    const btn = document.getElementById('sidebar-toggle');
    const overlay = document.getElementById('sidebar-overlay');

    function toggle() { document.body.classList.toggle('sidebar-open'); }
    btn?.addEventListener('click', toggle);
    overlay?.addEventListener('click', toggle);

    // Restore desktop state
    if (window.innerWidth >= 768) {
      document.body.classList.add('sidebar-open');
    }
  </script>
</body>
</html>
