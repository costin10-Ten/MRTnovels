---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';

const allStories = await getCollection('stories');
const sorted = allStories.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const TAG_LABELS: Record<string, string> = {
  thriller: '驚悚', politics: '政治', eco: '環保',
  mystery: '推理', scifi: '科幻', youth: '青春',
  romance: '感情', career: '職業',
};

// Group by tag for "file explorer" view
const allTags = ['thriller', 'politics', 'eco', 'mystery', 'scifi', 'youth', 'romance', 'career'];
const grouped = Object.fromEntries(
  allTags.map(tag => [
    tag,
    sorted.filter(s => s.data.tags.includes(tag)),
  ]),
);

const q = Astro.url.searchParams.get('q') ?? '';
const tag = Astro.url.searchParams.get('tag') ?? '';

const filtered = sorted.filter(s => {
  const matchTag = !tag || s.data.tags.includes(tag);
  const matchQ = !q || s.data.title.includes(q) || s.data.summary.includes(q);
  return matchTag && matchQ;
});
---

<BaseLayout
  title="內容索引"
  description="狂小說網全部文章索引，支援分類標籤篩選與搜尋。"
>
  <div class="max-w-2xl mx-auto px-5 py-10">
    <h1 class="text-sm font-medium text-gray-900 dark:text-gray-100 mb-6">內容索引</h1>

    <!-- Search + filter bar -->
    <form method="get" class="flex gap-2 mb-6">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="搜尋標題、摘要…"
        class="flex-1 border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#0f0f0f] text-gray-900 dark:text-gray-100 px-3 py-1.5 text-sm focus:outline-none focus:border-gray-400 dark:focus:border-gray-500 placeholder-gray-300 dark:placeholder-gray-600"
      />
      <button
        type="submit"
        class="px-4 py-1.5 border border-gray-300 dark:border-gray-600 text-sm text-gray-600 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
      >搜尋</button>
    </form>

    <!-- Tag pills -->
    <div class="flex flex-wrap gap-1.5 mb-8">
      <a
        href="/stories"
        class={`text-xs px-3 py-1 border transition-colors ${!tag ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100'}`}
      >全部</a>
      {allTags.map(t => (
        <a
          href={`/stories?tag=${t}${q ? '&q=' + encodeURIComponent(q) : ''}`}
          class={`text-xs px-3 py-1 border transition-colors ${tag === t ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100'}`}
        >
          {TAG_LABELS[t]}
        </a>
      ))}
    </div>

    {/* File-explorer view (no filter active) */}
    {!tag && !q ? (
      <div class="flex flex-col gap-6">
        {allTags.filter(t => grouped[t].length > 0).map(t => (
          <div>
            <div class="flex items-center gap-2 py-1.5 border-b border-gray-200 dark:border-gray-800 mb-1">
              <span class="text-xs text-gray-400 dark:text-gray-500">▶</span>
              <span class="text-xs font-medium text-gray-700 dark:text-gray-300 uppercase tracking-wider">{TAG_LABELS[t]}</span>
              <span class="text-xs text-gray-300 dark:text-gray-600 ml-auto">{grouped[t].length}</span>
            </div>
            {grouped[t].map(s => (
              <a
                href={`/stories/${s.slug}`}
                class="story-tree-item no-underline flex items-center justify-between"
              >
                <span class="flex items-center gap-2 min-w-0">
                  <span class="text-gray-300 dark:text-gray-600 text-xs">·</span>
                  <span class="truncate">{s.data.title}</span>
                </span>
                <div class="flex items-center gap-1.5 shrink-0 ml-2">
                  {s.data.access !== 'public' && <Badge type="access" value={s.data.access} />}
                  <span class="text-[10px] text-gray-300 dark:text-gray-600">
                    {s.data.publishDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </span>
                </div>
              </a>
            ))}
          </div>
        ))}
      </div>
    ) : (
      /* Filtered list view */
      <div class="flex flex-col">
        <div class="text-xs text-gray-400 dark:text-gray-500 mb-3">共 {filtered.length} 篇</div>
        {filtered.length === 0 ? (
          <p class="text-sm text-gray-400 dark:text-gray-500 py-8 text-center">找不到符合的文章。</p>
        ) : (
          filtered.map(s => (
            <a
              href={`/stories/${s.slug}`}
              class="flex items-baseline gap-3 py-2 px-1 hover:bg-gray-50 dark:hover:bg-gray-900 group no-underline border-b border-gray-100 dark:border-gray-800"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap w-24 shrink-0">
                {s.data.publishDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </span>
              <span class="text-sm text-gray-900 dark:text-gray-100 group-hover:underline flex-1 truncate">{s.data.title}</span>
              <div class="flex items-center gap-1.5 shrink-0">
                {s.data.access !== 'public' && <Badge type="access" value={s.data.access} />}
                {s.data.tags.slice(0, 1).map(t => <Badge type="tag" value={t} />)}
              </div>
            </a>
          ))
        )}
      </div>
    )}
  </div>
</BaseLayout>
