---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';

const allStories = await getCollection('stories');
const sorted = allStories.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const TAG_LABELS: Record<string, string> = {
  thriller: '驚悚', mystery: '推理', scifi: '科幻',
  humor: '幽默', sarcasm: '諷刺', romance: '愛情',
  youth: '青春', career: '職場', eco: '環保',
  politics: '政治', finance: '財經', society: '社會',
  tech: '科技', culture: '文化', essay: '散文',
  growth: '成長', family: '親情', taipei: '台北',
  food: '美食', health: '健康',
};

// Gather all tags that actually have stories, sorted by article count (descending)
const tagCounts = new Map<string, number>();
sorted.forEach(s => s.data.tags.forEach(t => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const orderedTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([t]) => t);

const grouped = Object.fromEntries(
  orderedTags.map(tag => [tag, sorted.filter(s => s.data.tags.includes(tag))]),
);

const q   = Astro.url.searchParams.get('q')   ?? '';
const tag = Astro.url.searchParams.get('tag') ?? '';

const filtered = sorted.filter(s => {
  const matchTag = !tag || s.data.tags.includes(tag);
  const matchQ   = !q   || s.data.title.includes(q) || s.data.summary.includes(q);
  return matchTag && matchQ;
});

// Seed for cover gradient from slug
function slugColor(slug: string) {
  const colors = [
    ['#1a1a2e','#16213e'], ['#2d1b69','#1a1033'],
    ['#0f3460','#162447'], ['#1b262c','#0f3460'],
    ['#2c003e','#1b1b2f'], ['#0d0d0d','#1a1a1a'],
    ['#16213e','#0f3460'], ['#1a0a2e','#2d1b69'],
  ];
  const i = slug.split('').reduce((a, c) => a + c.charCodeAt(0), 0) % colors.length;
  return colors[i];
}
---

<BaseLayout
  title="內容索引"
  description="狂小說網全部短篇故事索引。驚悚、推理、科幻、職場、青春、感情、政治、環保，依分類瀏覽或關鍵字搜尋。"
  keywords={['短篇故事', '驚悚', '推理', '科幻', '職場', '青春', '感情', '政治', '環保', '台灣小說']}
>
  <div class="w-full max-w-5xl mx-auto px-5 py-8">
    <h1 class="text-sm font-medium text-gray-900 dark:text-gray-100 mb-5">內容索引</h1>

    <!-- Search + tag bar -->
    <form method="get" class="flex gap-2 mb-4 max-w-md">
      <input
        type="text"
        name="q"
        value={q}
        placeholder="搜尋標題、摘要…"
        class="flex-1 min-w-0 border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#0f0f0f] text-gray-900 dark:text-gray-100 px-3 py-1.5 text-sm focus:outline-none focus:border-gray-400 dark:focus:border-gray-500 placeholder-gray-300 dark:placeholder-gray-600"
      />
      <button
        type="submit"
        class="shrink-0 px-4 py-1.5 border border-gray-300 dark:border-gray-600 text-sm text-gray-600 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100 transition-colors"
      >搜尋</button>
    </form>

    <!-- Tag pills -->
    <div class="flex flex-wrap gap-1.5 mb-8">
      <a
        href="/stories"
        class={`text-xs px-3 py-1 border transition-colors ${!tag ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100'}`}
      >全部</a>
      {orderedTags.map(t => (
        <a
          href={`/stories?tag=${t}${q ? '&q=' + encodeURIComponent(q) : ''}`}
          class={`text-xs px-3 py-1 border transition-colors ${tag === t ? 'border-gray-900 bg-gray-900 text-white dark:border-gray-100 dark:bg-gray-100 dark:text-gray-900' : 'border-gray-200 dark:border-gray-700 text-gray-500 dark:text-gray-400 hover:border-gray-900 dark:hover:border-gray-100 hover:text-gray-900 dark:hover:text-gray-100'}`}
        >
          {TAG_LABELS[t] ?? t}
        </a>
      ))}
    </div>

    {!tag && !q ? (
      /* ── Netflix rows ── */
      <div class="flex flex-col gap-10">
        {orderedTags.filter(t => grouped[t]?.length > 0).map(t => (
          <section>
            <!-- Row header -->
            <div class="flex items-baseline gap-2 mb-3">
              <h2 class="text-sm font-medium text-gray-900 dark:text-gray-100">
                {TAG_LABELS[t] ?? t}
              </h2>
              <span class="text-[10px] text-gray-300 dark:text-gray-600">{grouped[t].length} 篇</span>
              <a
                href={`/stories?tag=${t}`}
                class="ml-auto text-[11px] text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 no-underline whitespace-nowrap"
              >全部 →</a>
            </div>

            <!-- Horizontal scroll row -->
            <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide snap-x snap-mandatory">
              {grouped[t].map(s => {
                const [c1, c2] = slugColor(s.slug);
                const hasCover = !!s.data.cover;
                return (
                  <a
                    href={`/stories/${s.slug}`}
                    class="shrink-0 w-36 sm:w-44 snap-start no-underline group"
                  >
                    {/* Card thumbnail */}
                    <div class="relative w-full aspect-[3/4] rounded overflow-hidden mb-2">
                      {hasCover ? (
                        <img
                          src={s.data.cover}
                          alt={s.data.title}
                          class="w-full h-full object-cover grayscale opacity-80 group-hover:opacity-100 group-hover:grayscale-0 transition-all duration-300"
                          loading="lazy"
                        />
                      ) : (
                        <div
                          class="w-full h-full flex items-end p-2"
                          style={`background: linear-gradient(135deg, ${c1}, ${c2})`}
                        >
                          <span class="text-[10px] text-white/60 leading-tight line-clamp-2">
                            {s.data.title}
                          </span>
                        </div>
                      )}
                      {s.data.access !== 'public' && (
                        <div class="absolute top-1.5 right-1.5">
                          <Badge type="access" value={s.data.access} />
                        </div>
                      )}
                    </div>
                    {/* Card info */}
                    <div class="px-0.5">
                      <p class="text-xs text-gray-900 dark:text-gray-100 font-medium line-clamp-2 leading-snug group-hover:underline mb-1">
                        {s.data.title}
                      </p>
                      <p class="text-[10px] text-gray-400 dark:text-gray-500">
                        {s.data.publishDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                      </p>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        ))}
      </div>
    ) : (
      /* ── Filtered list view ── */
      <div class="flex flex-col">
        <div class="text-xs text-gray-400 dark:text-gray-500 mb-3">共 {filtered.length} 篇</div>
        {filtered.length === 0 ? (
          <p class="text-sm text-gray-400 dark:text-gray-500 py-8 text-center">找不到符合的文章。</p>
        ) : (
          filtered.map(s => (
            <a
              href={`/stories/${s.slug}`}
              class="flex items-baseline gap-3 py-2 px-1 hover:bg-gray-50 dark:hover:bg-gray-900 group no-underline border-b border-gray-100 dark:border-gray-800"
            >
              <span class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap w-24 shrink-0">
                {s.data.publishDate.toLocaleDateString('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' })}
              </span>
              <span class="text-sm text-gray-900 dark:text-gray-100 group-hover:underline flex-1 truncate">{s.data.title}</span>
              <div class="flex items-center gap-1.5 shrink-0">
                {s.data.access !== 'public' && <Badge type="access" value={s.data.access} />}
                {s.data.tags.slice(0, 1).map(t => <Badge type="tag" value={t} />)}
              </div>
            </a>
          ))
        )}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
