---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import LikeButton from '../../components/reader/LikeButton';
import ReadingTracker from '../../components/reader/ReadingTracker';
import CommentSection from '../../components/comments/CommentSection';
import ShareButtons from '../../components/ui/ShareButtons.astro';
import { incrementViews } from '../../lib/supabase';
import { getTags } from '../../lib/tags';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/stories');

const allStories = await getCollection('stories');
const sorted = allStories.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const idx = sorted.findIndex(s => s.slug === slug);
if (idx === -1) return Astro.redirect('/stories');

const story = sorted[idx];
const prev = sorted[idx + 1] ?? null;
const next = sorted[idx - 1] ?? null;

const { userId } = Astro.locals.auth();

// Access control
if (story.data.access === 'member' && !userId) {
  return Astro.redirect(`/sign-in?redirect=/stories/${slug}`);
}
if (story.data.access === 'paid' && !userId) {
  return Astro.redirect(`/sign-in?redirect=/stories/${slug}`);
}

// Increment view (fire and forget)
incrementViews(slug).catch(() => {});

const { Content } = await render(story);

const siteURL = import.meta.env.PUBLIC_SITE_URL ?? Astro.url.origin;
const canonicalURL = `${siteURL}/stories/${slug}`;

const storyTags = getTags(story.data);
const storyKeywords = storyTags;

const dateStr = story.data.publishDate.toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={story.data.title}
  description={story.data.summary}
  ogImage={story.data.cover}
  canonicalURL={canonicalURL}
  type="article"
  publishDate={story.data.publishDate}
  author={story.data.author}
  keywords={storyKeywords}
>
  <article class="max-w-2xl mx-auto px-5 py-10">

    <!-- Title -->
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100 leading-snug mb-4">
      {story.data.title}
    </h1>

    <!-- Meta row -->
    <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-2">
      <span id="meta-views">… 人讀過</span>
      <span>·</span>
      <span id="meta-likes">… 個讚</span>
      <span>·</span>
      <span>{dateStr}</span>
      <span>·</span>
      <span>{story.data.author}</span>
    </div>

    <!-- Tags -->
    <div class="flex flex-wrap items-center gap-1.5 mb-8">
      {story.data.access !== 'public' && <Badge type="access" value={story.data.access} />}
      {storyTags.map(t => <Badge type="tag" value={t} />)}
    </div>

    <!-- Cover image -->
    {story.data.cover && (
      <img
        src={story.data.cover}
        alt={story.data.title}
        class="w-full aspect-[2/1] object-cover mb-8 grayscale opacity-80"
      />
    )}

    <!-- Like button (top) -->
    <div class="flex items-center gap-3 mb-10">
      <LikeButton
        client:load
        storySlug={slug}
        initialLiked={false}
        initialCount={0}
      />
      {userId && (
        <a
          id="bookmark-btn"
          href={`/api/bookmarks?action=add&slug=${slug}&ref=/stories/${slug}`}
          class="text-sm text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
        >
          ☆ 收藏
        </a>
      )}
    </div>

    <!-- Share buttons -->
    <ShareButtons
      url={canonicalURL}
      title={story.data.title}
      description={story.data.summary}
      cover={story.data.cover}
      isAdmin={!!import.meta.env.PUBLIC_ADMIN_USER_ID && userId === import.meta.env.PUBLIC_ADMIN_USER_ID}
    />

    <!-- Reading progress bar -->
    <ReadingTracker
      client:load
      storySlug={slug}
      isLoggedIn={!!userId}
    />

    <!-- Article body -->
    <div id="story-content" class="story-body">
      <Content />
    </div>

    <!-- Like button (bottom) -->
    <div class="mt-12 flex justify-center">
      <LikeButton
        client:load
        storySlug={slug}
        initialLiked={false}
        initialCount={0}
      />
    </div>

    <!-- Prev / Next -->
    <nav class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800 flex items-center justify-between gap-4 text-sm">
      {prev ? (
        <a href={`/stories/${prev.slug}`} class="flex-1 text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors group">
          <div class="text-[10px] text-gray-300 dark:text-gray-600 uppercase tracking-widest mb-1">上一篇</div>
          <div class="group-hover:underline line-clamp-1">{prev.data.title}</div>
        </a>
      ) : <div class="flex-1" />}

      {next ? (
        <a href={`/stories/${next.slug}`} class="flex-1 text-right text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors group">
          <div class="text-[10px] text-gray-300 dark:text-gray-600 uppercase tracking-widest mb-1">下一篇</div>
          <div class="group-hover:underline line-clamp-1">{next.data.title}</div>
        </a>
      ) : <div class="flex-1" />}
    </nav>

    <!-- Comments -->
    <CommentSection
      client:load
      storySlug={slug}
      initialComments={[]}
      isLoggedIn={!!userId}
    />
  </article>
</BaseLayout>

<script define:vars={{ slug, isLoggedIn: !!userId }}>
  // Fetch story state (stats + liked + bookmarked) client-side to avoid blocking SSR
  fetch(`/api/story-state?slug=${encodeURIComponent(slug)}`)
    .then(r => r.json())
    .then(({ stats, liked, bookmarked }) => {
      // Update meta row
      const mv = document.getElementById('meta-views');
      const ml = document.getElementById('meta-likes');
      if (mv) mv.textContent = `${(stats.views ?? 0).toLocaleString('zh-TW')} 人讀過`;
      if (ml) ml.textContent = `${(stats.likes ?? 0).toLocaleString('zh-TW')} 個讚`;

      // Update LikeButton state via custom event (both top + bottom instances)
      window.dispatchEvent(new CustomEvent('like-sync', {
        detail: { slug, liked: !!liked, count: stats.likes ?? 0 },
      }));

      // Update bookmark button
      const bm = document.getElementById('bookmark-btn');
      if (bm && bookmarked) {
        bm.textContent = '★ 已收藏';
        bm.href = `/api/bookmarks?action=remove&slug=${encodeURIComponent(slug)}&ref=/stories/${encodeURIComponent(slug)}`;
      }
    })
    .catch(() => {
      const mv = document.getElementById('meta-views');
      const ml = document.getElementById('meta-likes');
      if (mv) mv.textContent = '';
      if (ml) ml.textContent = '';
    });
</script>
