---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/tags';

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect('/sign-in');

const allStories = await getCollection('stories');
const storyMap = Object.fromEntries(
  allStories.map(s => [s.slug, {
    title: s.data.title,
    tag: getTags(s.data)[0] ?? '',
    date: s.data.publishDate.toLocaleDateString('zh-TW', { month: '2-digit', day: '2-digit' }),
    ts: s.data.publishDate.getTime(),
  }])
);
---

<BaseLayout title="我按讚的文章" noindex={true}>
  <div class="max-w-xl mx-auto px-5 py-10">
    <div class="flex items-center gap-4 mb-6">
      <a href="/member" class="text-xs text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300">← 會員中心</a>
    </div>
    <div class="flex items-baseline justify-between mb-6">
      <h1 class="text-sm font-medium text-gray-900 dark:text-gray-100">我按讚的文章</h1>
      <span id="likes-count" class="text-xs text-gray-400 dark:text-gray-500 tabular-nums"></span>
    </div>

    <div id="likes-list">
      <div class="py-8 text-center text-xs text-gray-300 dark:text-gray-600">載入中…</div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ storyMap }}>
  fetch('/api/member-stats')
    .then(r => { if (!r.ok) throw new Error(); return r.json(); })
    .then(({ likedSlugs }) => {
      const list = document.getElementById('likes-list');

      const liked = likedSlugs
        .map(slug => ({ slug, ...storyMap[slug] }))
        .filter(s => s.title)
        .sort((a, b) => b.ts - a.ts);

      if (liked.length > 0) {
        document.getElementById('likes-count').textContent = `${liked.length} 篇`;
      }

      if (liked.length === 0) {
        list.innerHTML = `
          <div class="py-16 text-center">
            <div class="text-3xl mb-4 opacity-30">♡</div>
            <p class="text-sm text-gray-400 dark:text-gray-500 mb-2">還沒有按讚的文章</p>
            <a href="/stories" class="text-xs underline text-gray-500 dark:text-gray-400">去看看文章</a>
          </div>`;
        return;
      }

      list.innerHTML = '<div class="flex flex-col">' + liked.map(story => {
        const tagBadge = story.tag
          ? `<span class="inline-block text-[10px] px-1.5 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-500 dark:text-gray-400">${story.tag}</span>`
          : '';
        return `
          <div class="flex items-center gap-3 py-2.5 border-b border-gray-100 dark:border-gray-800">
            <a href="/stories/${story.slug}" class="flex-1 min-w-0 group no-underline">
              <div class="flex items-baseline gap-2">
                <span class="text-xs text-gray-300 dark:text-gray-600 whitespace-nowrap w-12 shrink-0">${story.date}</span>
                <span class="text-sm text-gray-900 dark:text-gray-100 group-hover:underline truncate">${story.title}</span>
              </div>
            </a>
            <div class="flex items-center gap-1.5 shrink-0">${tagBadge}</div>
          </div>`;
      }).join('') + '</div>';
    })
    .catch(() => {
      document.getElementById('likes-list').innerHTML =
        '<div class="py-8 text-center text-xs text-gray-400 dark:text-gray-500">載入失敗，請重新整理</div>';
    });
</script>
