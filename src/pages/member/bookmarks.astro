---
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import { getBookmarks } from '../../lib/supabase';

const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect('/sign-in');

const allStories = await getCollection('stories');
const storyMap = Object.fromEntries(allStories.map(s => [s.slug, s]));

const bookmarks = await getBookmarks(userId);
---

<BaseLayout title="收藏清單">
  <div class="max-w-xl mx-auto px-5 py-10">
    <div class="flex items-center gap-4 mb-6">
      <a href="/member" class="text-xs text-gray-400 hover:text-gray-700">← 會員中心</a>
    </div>
    <h1 class="text-sm font-medium text-gray-900 mb-6">收藏清單</h1>

    {bookmarks.length === 0 ? (
      <p class="text-sm text-gray-400 py-8 text-center">
        還沒有收藏文章。<a href="/stories" class="underline text-gray-600">去看看文章</a>。
      </p>
    ) : (
      <div class="flex flex-col">
        {bookmarks.map(b => {
          const story = storyMap[b.story_slug];
          if (!story) return null;
          return (
            <div class="flex items-center gap-3 py-2.5 border-b border-gray-100">
              <a
                href={`/stories/${b.story_slug}`}
                class="flex-1 min-w-0 text-sm text-gray-900 hover:underline truncate"
              >
                {story.data.title}
              </a>
              <div class="flex items-center gap-1.5 shrink-0">
                {story.data.tags.slice(0, 1).map(t => <Badge type="tag" value={t} />)}
                <a
                  href={`/api/bookmarks?action=remove&slug=${b.story_slug}&ref=/member/bookmarks`}
                  class="text-xs text-gray-300 hover:text-gray-500 ml-2 transition-colors"
                  title="移除收藏"
                >✕</a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
