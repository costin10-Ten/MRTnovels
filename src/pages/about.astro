---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getGlobalStats } from '../lib/supabase';

const allStories = await getCollection('stories');
const stats = await getGlobalStats().catch(() => ({ views: 0, likes: 0 }));

const MILESTONES = [
  { date: '2023-01', label: '第一篇文章上線', done: true },
  { date: '2023-06', label: '累計 10 篇文章', done: true },
  { date: '2024-01', label: '累計 1,000 瀏覽', done: stats.views >= 1000 },
  { date: '2024-06', label: '累計 20 篇文章', done: allStories.length >= 20 },
  { date: '2025-01', label: '累計 10,000 瀏覽', done: stats.views >= 10000 },
  { date: '?', label: '100 萬個讚', done: stats.likes >= 1000000 },
];
---

<BaseLayout
  title="關於本站"
  description="狂小說網的故事：一個人、一個網站、通勤時間裡的文學宇宙。"
>
  <article class="max-w-xl mx-auto px-5 py-10">
    <h1 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-8">關於本站</h1>

    <section class="story-body text-base mb-12">
      <p>
        這個網站是我為了個人的喜好做的。
      </p>
      <p>
        我喜歡在通勤的時候讀短篇故事——不需要記情節、不用從上次讀到哪裡找起，一篇完整的東西，從捷運到公司剛好讀完，像是每天早上給自己一小塊時間，活在別人的故事裡。
      </p>
      <p>
        所以我開始寫，也開始把這個地方建起來。沒有複雜的設計，沒有演算法，沒有廣告。就是一個能好好讀文章的地方。
      </p>
      <p>
        這個網站，獻給我的老婆——她是第一個讀者，也是最誠實的讀者。
        也獻給所有喜愛通勤文學的你，謝謝你願意把通勤的時間花在這裡。
      </p>
    </section>

    <!-- 100 萬按讚企劃 -->
    <section id="million" class="mb-12">
      <h2 class="text-[10px] text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-4">100 萬按讚企劃</h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 leading-relaxed">
        目標是讓這個網站收到 100 萬個讚。不是 follower、不是點擊，是每一篇故事讓你覺得值得按的那個讚。
      </p>
      <div class="mb-2">
        <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 mb-1.5">
          <span>目前進度</span>
          <span class="tabular-nums">{stats.likes.toLocaleString('zh-TW')} / 1,000,000</span>
        </div>
        <div class="h-2 bg-gray-100 dark:bg-gray-800 rounded-full overflow-hidden">
          <div
            class="h-full bg-gray-900 dark:bg-gray-100 rounded-full transition-all"
            style={`width: ${Math.min(100, (stats.likes / 1000000) * 100).toFixed(2)}%`}
          ></div>
        </div>
        <div class="text-right text-[10px] text-gray-300 dark:text-gray-600 mt-1">
          {((stats.likes / 1000000) * 100).toFixed(3)}%
        </div>
      </div>
    </section>

    <!-- Milestones -->
    <section>
      <h2 class="text-[10px] text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-4">網站里程碑</h2>
      <ul class="flex flex-col gap-2">
        {MILESTONES.map(m => (
          <li class="flex items-center gap-3 text-sm">
            <span class={`w-3.5 h-3.5 rounded-full shrink-0 border-2 ${m.done ? 'bg-gray-900 border-gray-900 dark:bg-gray-100 dark:border-gray-100' : 'border-gray-300 dark:border-gray-600'}`}></span>
            <span class={m.done ? 'text-gray-700 dark:text-gray-300' : 'text-gray-400 dark:text-gray-600'}>{m.label}</span>
            <span class="text-[10px] text-gray-300 dark:text-gray-600 ml-auto">{m.date}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800 text-xs text-gray-400 dark:text-gray-500">
      目前共 {allStories.length} 篇文章 · {stats.views.toLocaleString('zh-TW')} 次瀏覽
    </div>
  </article>
</BaseLayout>
