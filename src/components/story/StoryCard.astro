---
import Badge from '../ui/Badge.astro';

interface Props {
  slug: string;
  title: string;
  publishDate: Date;
  author: string;
  tags: string[];
  access: string;
  summary: string;
  views?: number;
  likes?: number;
  variant?: 'featured' | 'row';
}

const {
  slug,
  title,
  publishDate,
  author,
  tags,
  access,
  summary,
  views = 0,
  likes = 0,
  variant = 'row',
} = Astro.props;

const dateStr = publishDate.toLocaleDateString('zh-TW', {
  year: 'numeric', month: '2-digit', day: '2-digit',
});
---

{variant === 'featured' ? (
  <!-- Featured card (homepage top 5) -->
  <article class="border-b border-gray-200 py-5 first:border-t">
    <div class="flex items-start justify-between gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1.5">
          {access !== 'public' && <Badge type="access" value={access} />}
          {tags.slice(0, 2).map(t => <Badge type="tag" value={t} />)}
        </div>
        <a href={`/stories/${slug}`} class="block group no-underline">
          <h2 class="text-base font-medium text-gray-900 group-hover:underline leading-snug mb-1.5">
            {title}
          </h2>
          <p class="text-sm text-gray-500 leading-relaxed line-clamp-2">{summary}</p>
        </a>
        <div class="flex items-center gap-3 mt-2 text-xs text-gray-400">
          <span>{dateStr}</span>
          <span>·</span>
          <span>{author}</span>
          {views > 0 && <><span>·</span><span>{views.toLocaleString('zh-TW')} 讀</span></>}
          {likes > 0 && <><span>·</span><span>{likes.toLocaleString('zh-TW')} 讚</span></>}
        </div>
      </div>
    </div>
  </article>
) : (
  <!-- Row variant (full list) -->
  <a
    href={`/stories/${slug}`}
    class="flex items-baseline gap-3 py-2 px-1 hover:bg-gray-50 group no-underline border-b border-gray-100"
  >
    <span class="text-xs text-gray-400 whitespace-nowrap w-24 shrink-0">{dateStr}</span>
    <span class="text-sm text-gray-900 group-hover:underline flex-1 min-w-0 truncate">{title}</span>
    <div class="flex items-center gap-1.5 shrink-0">
      {access !== 'public' && <Badge type="access" value={access} />}
      {tags.slice(0, 1).map(t => <Badge type="tag" value={t} />)}
    </div>
  </a>
)}
