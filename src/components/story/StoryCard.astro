---
import Badge from '../ui/Badge.astro';

interface Props {
  slug: string;
  title: string;
  publishDate: Date;
  author: string;
  tags: string[];
  access: string;
  summary: string;
  cover?: string;
  views?: number;
  likes?: number;
  variant?: 'featured' | 'row';
}

const {
  slug,
  title,
  publishDate,
  author,
  tags,
  access,
  summary,
  cover,
  views = 0,
  likes = 0,
  variant = 'row',
} = Astro.props;

const dateStr = publishDate.toLocaleDateString('zh-TW', {
  year: 'numeric', month: '2-digit', day: '2-digit',
});
---

{variant === 'featured' ? (
  <article class="bg-white dark:bg-[#303134] rounded-xl border border-[#dadce0] dark:border-[#3c4043] overflow-hidden hover:shadow-md transition-shadow">
    {cover && (
      <a href={`/stories/${slug}`} class="block overflow-hidden" tabindex="-1">
        <img
          src={cover}
          alt={title}
          class="w-full h-36 object-cover grayscale opacity-80 hover:opacity-90 transition-opacity"
          loading="lazy"
        />
      </a>
    )}
    <div class="flex items-start gap-4 px-5 py-4">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5 mb-2">
          {access !== 'public' && <Badge type="access" value={access} />}
          {tags.slice(0, 2).map(t => <Badge type="tag" value={t} />)}
        </div>
        <a href={`/stories/${slug}`} class="block group no-underline hover:no-underline">
          <h2 class="text-[0.9375rem] font-medium text-[#202124] dark:text-[#e8eaed] group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] leading-snug mb-2 transition-colors">
            {title}
          </h2>
          <p class="text-sm text-[#5f6368] dark:text-[#9aa0a6] leading-relaxed line-clamp-2">{summary}</p>
        </a>
        <div class="flex items-center gap-2 mt-2.5 text-xs text-[#9aa0a6]">
          <span>{dateStr}</span>
          <span>·</span>
          <span>{author}</span>
          <span class="story-stats" data-slug={slug}>
            {views > 0 && `· ${views.toLocaleString('zh-TW')} 讀`}
            {likes > 0 && ` · ${likes.toLocaleString('zh-TW')} 讚`}
          </span>
        </div>
      </div>
    </div>
  </article>
) : (

  <a
    href={`/stories/${slug}`}
    class="flex items-baseline gap-3 py-2 px-3 rounded-lg hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] group no-underline hover:no-underline transition-colors"
  >
    <span class="text-xs text-[#9aa0a6] whitespace-nowrap w-24 shrink-0">{dateStr}</span>
    <span class="text-sm text-[#202124] dark:text-[#e8eaed] group-hover:text-[#1a73e8] dark:group-hover:text-[#8ab4f8] flex-1 min-w-0 truncate transition-colors">{title}</span>
    <div class="flex items-center gap-1.5 shrink-0">
      {access !== 'public' && <Badge type="access" value={access} />}
      {tags.slice(0, 1).map(t => <Badge type="tag" value={t} />)}
    </div>
  </a>
)}
