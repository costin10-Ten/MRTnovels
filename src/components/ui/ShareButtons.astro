---
interface Props {
  url: string;
  title: string;
  description?: string;
  cover?: string;
}

const { url, title, description = '', cover } = Astro.props;

const encoded = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const encodedDesc  = encodeURIComponent(description);

const lineURL    = `https://social-plugins.line.me/lineit/share?url=${encoded}`;
const fbURL      = `https://www.facebook.com/sharer/sharer.php?u=${encoded}`;
const threadsURL = `https://www.threads.net/intent/post?text=${encodedTitle}%0A%0A${encodedDesc}%0A%0A${encoded}`;
---

<div class="flex flex-wrap items-center gap-2 my-6" id="share-row">
  <!-- LINE -->
  <a
    href={lineURL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="分享到 LINE"
    class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium text-white transition-opacity hover:opacity-80 no-underline"
    style="background:#06c755"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2C6.477 2 2 6.028 2 11.029c0 4.5 3.875 8.26 9.112 8.924.354.077.836.235.958.54.11.277.072.71.035 1.01l-.153.953c-.047.276-.215 1.08.945.59 1.16-.492 6.264-3.69 8.546-6.32C22.77 14.99 22 13.1 22 11.03 22 6.028 17.523 2 12 2z"/>
    </svg>
    LINE
  </a>

  <!-- Facebook -->
  <a
    href={fbURL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="分享到 Facebook"
    class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium text-white transition-opacity hover:opacity-80 no-underline"
    style="background:#1877f2"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
    Facebook
  </a>

  <!-- Threads -->
  <a
    href={threadsURL}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="分享到 Threads"
    class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium text-white transition-opacity hover:opacity-80 no-underline dark:bg-[#1a1a1a]"
    style="background:#101010"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.028-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-.505-1.856-1.445-3.317-2.79-4.346-1.388-1.062-3.26-1.608-5.533-1.622-2.905.02-5.121.978-6.585 2.85-1.398 1.79-2.113 4.304-2.136 7.474.023 3.178.739 5.69 2.133 7.485 1.462 1.873 3.68 2.833 6.587 2.853 2.018-.016 3.682-.425 4.951-1.218 1.31-.818 2.028-2.02 2.176-3.67.155-1.778-.274-3.109-1.274-3.954-.538-.456-1.208-.773-1.993-.944-.295 1.987-1.049 3.535-2.25 4.584-1.335 1.166-3.09 1.744-5.22 1.716-1.59-.02-2.93-.497-3.883-1.376-.978-.9-1.487-2.168-1.43-3.577.113-2.78 2.247-4.635 5.582-4.825 1.17-.066 2.336-.021 3.497.133-.167-.945-.544-1.645-1.12-2.082-.665-.505-1.62-.762-2.842-.762h-.02c-.934.004-1.73.239-2.37.698-.584.424-.986 1.047-1.104 1.836l-2.069-.26c.198-1.308.834-2.397 1.841-3.142.964-.714 2.197-1.089 3.666-1.095h.025c1.71 0 3.138.408 4.245 1.214 1.16.845 1.893 2.127 2.176 3.813.182.01.363.022.542.036 1.3.109 2.499.56 3.47 1.369 1.567 1.327 2.28 3.311 2.07 5.77-.23 2.683-1.376 4.705-3.308 5.862-1.655 1.006-3.744 1.522-6.207 1.537z"/>
    </svg>
    Threads
  </a>

  <!-- Copy link -->
  <button
    id="copy-link-btn"
    type="button"
    aria-label="複製連結"
    data-url={url}
    class="flex items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium border border-[#dadce0] dark:border-[#3c4043] text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-colors cursor-pointer"
  >
    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <rect x="9" y="2" width="9" height="9" rx="1.5"/><path d="M5 7H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-2"/>
    </svg>
    <span id="copy-link-text">複製連結</span>
  </button>

  <!-- Web Share API (mobile) -->
  <button
    id="native-share-btn"
    type="button"
    data-url={url}
    data-title={title}
    data-text={description}
    class="hidden items-center gap-1.5 px-4 py-1.5 rounded-full text-xs font-medium border border-[#dadce0] dark:border-[#3c4043] text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] transition-colors cursor-pointer"
  >
    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <circle cx="15" cy="4" r="2"/><circle cx="5" cy="10" r="2"/><circle cx="15" cy="16" r="2"/>
      <line x1="7" y1="11" x2="13" y2="15"/><line x1="7" y1="9" x2="13" y2="5"/>
    </svg>
    分享
  </button>
</div>

<script>
  // Copy link
  const copyBtn = document.getElementById('copy-link-btn') as HTMLButtonElement | null;
  const copyText = document.getElementById('copy-link-text');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.url ?? location.href;
    try {
      await navigator.clipboard.writeText(url);
      if (copyText) { copyText.textContent = '已複製！'; setTimeout(() => { copyText.textContent = '複製連結'; }, 2000); }
    } catch {
      prompt('複製此連結：', url);
    }
  });

  // Web Share API — show only if supported (usually mobile)
  const nativeBtn = document.getElementById('native-share-btn') as HTMLButtonElement | null;
  if (nativeBtn && 'share' in navigator) {
    nativeBtn.classList.remove('hidden');
    nativeBtn.classList.add('flex');
    nativeBtn.addEventListener('click', () => {
      navigator.share({
        title: nativeBtn.dataset.title ?? '',
        text:  nativeBtn.dataset.text  ?? '',
        url:   nativeBtn.dataset.url   ?? location.href,
      }).catch(() => {});
    });
  }
</script>
