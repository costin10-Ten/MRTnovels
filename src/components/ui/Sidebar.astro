---
import SidebarSettings from './SidebarSettings';
import { SignedIn } from '@clerk/astro/components';

interface Props {
  views: number;
  likes: number;
}
const { views, likes } = Astro.props;

const NAV = [
  { href: '/',              label: '首頁',          icon: 'home'  },
  { href: '/stories',       label: '內容索引',      icon: 'list'  },
  { href: '/member',        label: '會員資料',      icon: 'user',   memberOnly: true },
  { href: '/upload-story',  label: '上傳文章',      icon: 'upload', memberOnly: true },
  { href: '/sign-up',       label: '加入會員',      icon: 'plus',   guestOnly: true  },
  { href: '/about',         label: '關於本站',      icon: 'info'  },
  { href: '/about#million', label: '100萬按讚企劃', icon: 'heart' },
];

function fmt(n: number) {
  return n >= 10000 ? (n / 10000).toFixed(1) + ' 萬' : n.toLocaleString('zh-TW');
}

const currentPath = Astro.url.pathname;
const { userId } = Astro.locals.auth();
---
<aside class="sidebar py-4 px-3 select-none">

  <!-- Logo (desktop) -->
  <div class="hidden md:flex items-center gap-2.5 mb-5 px-2">
    <a href="/" class="flex items-center gap-2.5 no-underline hover:no-underline group">
      <div class="w-8 h-8 rounded-xl bg-[#1a73e8] flex items-center justify-center shadow-sm flex-shrink-0 group-hover:bg-[#1557b0] transition-colors">
        <span class="text-white font-bold text-sm leading-none">狂</span>
      </div>
      <div class="flex flex-col leading-none">
        <span class="text-[0.8125rem] font-semibold text-[#202124] dark:text-[#e8eaed] tracking-tight">小說網</span>
        <span class="text-[9px] text-[#9aa0a6] tracking-widest mt-0.5">通勤文學速讀</span>
      </div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex flex-col gap-0.5">
    {NAV.map(({ href, label, icon, memberOnly, guestOnly }) => {
      if (memberOnly && !userId) return null;
      if (guestOnly  &&  userId) return null;
      const isHome = href === '/';
      const active = isHome
        ? currentPath === '/'
        : currentPath === href || (currentPath.startsWith(href) && href !== '/sign-up' && href !== '/about#million');
      return (
        <a
          href={href}
          class={`flex items-center gap-3 px-3 py-2 rounded-full text-sm font-medium transition-colors no-underline hover:no-underline ${
            active
              ? 'bg-[#e8f0fe] text-[#1a73e8] dark:bg-[#1e3a5f] dark:text-[#8ab4f8]'
              : 'text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] hover:text-[#202124] dark:hover:bg-[#3c4043] dark:hover:text-[#e8eaed]'
          }`}
        >
          {icon === 'home'  && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><path d="M10 2L2 9h2v9h5v-5h2v5h5V9h2L10 2z"/></svg>}
          {icon === 'list'  && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><rect x="2" y="4" width="16" height="1.5" rx="1"/><rect x="2" y="9" width="16" height="1.5" rx="1"/><rect x="2" y="14" width="10" height="1.5" rx="1"/></svg>}
          {icon === 'user'  && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><circle cx="10" cy="7" r="4"/><path d="M2 18c0-4 3.6-7 8-7s8 3 8 7"/></svg>}
          {icon === 'plus'   && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><rect x="9" y="2" width="2" height="16" rx="1"/><rect x="2" y="9" width="16" height="2" rx="1"/></svg>}
          {icon === 'upload' && <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" class="flex-shrink-0 opacity-80"><path d="M3 14v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3"/><polyline points="13 7 10 4 7 7"/><line x1="10" y1="4" x2="10" y2="13"/></svg>}
          {icon === 'info'  && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="9.25" y="9" width="1.5" height="6" rx="0.75"/><circle cx="10" cy="6.5" r="1"/></svg>}
          {icon === 'heart' && <svg width="15" height="15" viewBox="0 0 20 20" fill="currentColor" class="flex-shrink-0 opacity-80"><path d="M10 17s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 17 8c0 4.5-7 9-7 9z"/></svg>}
          <span>{label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Divider -->
  <div class="border-t border-[#dadce0] dark:border-[#3c4043] my-4"></div>

  <!-- Stats -->
  <div class="flex flex-col gap-3 px-3 mb-4">
    <div>
      <div class="text-[10px] text-[#9aa0a6] uppercase tracking-widest mb-0.5">瀏覽人次</div>
      <div class="text-lg font-light text-[#202124] dark:text-[#e8eaed] tabular-nums">{fmt(views)}</div>
    </div>
    <div>
      <div class="text-[10px] text-[#9aa0a6] uppercase tracking-widest mb-0.5">總按讚數</div>
      <div class="text-lg font-light text-[#202124] dark:text-[#e8eaed] tabular-nums">{fmt(likes)}</div>
    </div>
  </div>

  <!-- Divider -->
  <div class="border-t border-[#dadce0] dark:border-[#3c4043] mb-2"></div>

  <!-- Settings panel -->
  <SidebarSettings client:load />
</aside>
