---
interface Props {
  views: number;
  likes: number;
}
const { views, likes } = Astro.props;

const NAV = [
  { href: '/stories', label: '內容索引', icon: '≡' },
  { href: '/sign-up', label: '加入會員', icon: '+' },
  { href: '/about', label: '關於本站', icon: 'ℹ' },
  { href: '/about#million', label: '100萬按讚企劃', icon: '♥' },
];

function fmt(n: number) {
  return n >= 10000
    ? (n / 10000).toFixed(1) + ' 萬'
    : n.toLocaleString('zh-TW');
}

const currentPath = Astro.url.pathname;
---
<aside class="sidebar py-4 px-3 select-none">
  <!-- Site brand (desktop) -->
  <div class="hidden md:block mb-5 px-3">
    <a href="/" class="block no-underline hover:no-underline">
      <div class="text-sm font-medium text-[#202124] dark:text-[#e8eaed] leading-snug">狂小說網</div>
      <div class="text-[10px] text-[#9aa0a6] tracking-widest mt-0.5">通勤文學速讀</div>
    </a>
  </div>

  <!-- Navigation -->
  <nav class="flex flex-col gap-0.5">
    {NAV.map(({ href, label, icon }) => {
      const active = currentPath === href || (href !== '/' && currentPath.startsWith(href) && href !== '/sign-up');
      return (
        <a
          href={href}
          class={`flex items-center gap-3 px-3 py-2 rounded-full text-sm font-medium transition-colors no-underline hover:no-underline ${
            active
              ? 'bg-[#e8f0fe] text-[#1a73e8] dark:bg-[#1e3a5f] dark:text-[#8ab4f8]'
              : 'text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] hover:text-[#202124] dark:hover:bg-[#3c4043] dark:hover:text-[#e8eaed]'
          }`}
        >
          <span class="w-4 text-center text-xs">{icon}</span>
          <span>{label}</span>
        </a>
      );
    })}
  </nav>

  <!-- Divider -->
  <div class="border-t border-[#dadce0] dark:border-[#3c4043] my-4"></div>

  <!-- Stats -->
  <div class="flex flex-col gap-4 px-3">
    <div>
      <div class="text-[10px] text-[#9aa0a6] uppercase tracking-widest mb-0.5">瀏覽人次</div>
      <div class="text-lg font-light text-[#202124] dark:text-[#e8eaed] tabular-nums">{fmt(views)}</div>
    </div>
    <div>
      <div class="text-[10px] text-[#9aa0a6] uppercase tracking-widest mb-0.5">總按讚數</div>
      <div class="text-lg font-light text-[#202124] dark:text-[#e8eaed] tabular-nums">{fmt(likes)}</div>
    </div>
  </div>
</aside>
