---
// Auth state is decided 100% by SSR (cookie-verified by Clerk middleware).
// No Clerk client components here: ClerkJS hydration must never be able to
// flip the header to logged-out after the page has rendered.
const { userId } = Astro.locals.auth();
---
<header class="top-bar">
  <div class="flex items-center gap-3">
    <button
      id="sidebar-toggle"
      aria-label="開關側欄"
      class="p-1 text-[#5f6368] hover:text-[#202124] dark:text-[#9aa0a6] dark:hover:text-[#e8eaed] md:hidden"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <rect y="3" width="20" height="1.5" rx="1"/>
        <rect y="9" width="20" height="1.5" rx="1"/>
        <rect y="15" width="20" height="1.5" rx="1"/>
      </svg>
    </button>
    <a href="/" class="flex items-center gap-2 no-underline hover:no-underline group">
      <!-- Logo mark -->
      <div class="w-7 h-7 rounded-lg bg-[#1a73e8] flex items-center justify-center flex-shrink-0 group-hover:bg-[#1557b0] transition-colors">
        <span class="text-white font-bold text-xs leading-none tracking-tight">狂</span>
      </div>
      <div class="flex flex-col leading-none">
        <span class="text-[0.8125rem] font-semibold tracking-tight text-[#202124] dark:text-[#e8eaed]">小說網</span>
        <span class="text-[9px] text-[#9aa0a6] tracking-widest mt-0.5">通勤文學速讀</span>
      </div>
    </a>
  </div>

  <div class="flex items-center gap-3 text-sm">
    {userId ? (
      <>
        <a
          href="/member"
          class="text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] text-xs transition-colors no-underline"
        >我的</a>
        <div class="relative">
          <button
            id="user-menu-btn"
            aria-label="會員選單"
            class="w-7 h-7 rounded-full bg-[#1a73e8] text-white text-xs font-medium flex items-center justify-center hover:bg-[#1557b0] transition-colors"
          >我</button>
          <div
            id="user-menu"
            class="hidden absolute right-0 top-9 z-50 min-w-[120px] bg-white dark:bg-[#303134] border border-[#dadce0] dark:border-[#3c4043] rounded-xl shadow-lg py-1.5"
          >
            <a href="/member" class="block px-4 py-2 text-xs text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043] no-underline">會員中心</a>
            <button id="sign-out-btn" class="w-full text-left px-4 py-2 text-xs text-[#5f6368] dark:text-[#9aa0a6] hover:bg-[#f1f3f4] dark:hover:bg-[#3c4043]">登出</button>
          </div>
        </div>
      </>
    ) : (
      <>
        <a
          href="/sign-in"
          class="text-[#5f6368] dark:text-[#9aa0a6] hover:text-[#1a73e8] dark:hover:text-[#8ab4f8] transition-colors no-underline"
        >登入</a>
        <a
          href="/sign-up"
          class="px-4 py-1.5 rounded-full bg-[#1a73e8] text-white text-xs font-medium hover:bg-[#1557b0] transition-colors no-underline"
        >加入會員</a>
      </>
    )}
  </div>
</header>

<script>
  const menuBtn = document.getElementById('user-menu-btn');
  const menu = document.getElementById('user-menu');

  menuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
  });
  document.addEventListener('click', () => menu?.classList.add('hidden'));

  document.getElementById('sign-out-btn')?.addEventListener('click', async () => {
    const clerk = (window as any).Clerk;
    try {
      if (clerk?.signOut) {
        await clerk.signOut();
      }
    } finally {
      window.location.href = '/';
    }
  });
</script>
