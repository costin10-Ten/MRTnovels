---
import { SignedIn, SignedOut, UserButton } from '@clerk/astro/components';
---
<header class="top-bar">
  <!-- Left: hamburger + site name -->
  <div class="flex items-center gap-3">
    <button
      id="sidebar-toggle"
      aria-label="開關側欄"
      class="p-1 text-gray-500 hover:text-gray-900 md:hidden"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
        <rect y="3" width="20" height="1.5" rx="1"/>
        <rect y="9" width="20" height="1.5" rx="1"/>
        <rect y="15" width="20" height="1.5" rx="1"/>
      </svg>
    </button>
    <a href="/" class="flex flex-col leading-none no-underline">
      <span class="text-sm font-semibold tracking-tight text-gray-900">狂小說網</span>
      <span class="text-[10px] text-gray-400 tracking-widest">通勤文學速讀</span>
    </a>
  </div>

  <!-- Right: auth -->
  <div class="flex items-center gap-3 text-sm">
    <SignedOut>
      <a
        href="/sign-in"
        class="text-gray-500 hover:text-gray-900 transition-colors"
      >登入</a>
      <a
        href="/sign-up"
        class="px-3 py-1 border border-gray-300 text-gray-700 hover:border-gray-900 hover:text-gray-900 transition-colors text-xs"
      >加入會員</a>
    </SignedOut>
    <SignedIn>
      <a href="/member" class="text-gray-500 hover:text-gray-900 text-xs transition-colors">我的</a>
      <UserButton />
    </SignedIn>
  </div>
</header>
