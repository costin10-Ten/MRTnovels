---
interface Props {
  type: 'access' | 'tag';
  value: string;
}
const { type, value } = Astro.props;

const TAG_LABELS: Record<string, string> = {
  thriller: '驚悚',
  politics: '政治',
  eco:      '環保',
  mystery:  '推理',
  scifi:    '科幻',
  youth:    '青春',
  romance:  '感情',
  career:   '職業',
};

// Google chip style: rounded-full, subtle background
const ACCESS_CONFIG: Record<string, { label: string; cls: string }> = {
  public:  { label: '公開',  cls: 'bg-[#f1f3f4] text-[#5f6368] dark:bg-[#3c4043] dark:text-[#9aa0a6]' },
  member:  { label: '會員',  cls: 'bg-[#e8f0fe] text-[#1a73e8] dark:bg-[#1e3a5f] dark:text-[#8ab4f8]' },
  paid:    { label: '付費',  cls: 'bg-[#202124] text-[#e8eaed] dark:bg-[#e8eaed] dark:text-[#202124]' },
};

let label = '';
let cls = '';

if (type === 'tag') {
  label = TAG_LABELS[value] ?? value;
  cls = 'bg-[#f1f3f4] text-[#5f6368] dark:bg-[#3c4043] dark:text-[#9aa0a6]';
} else {
  const cfg = ACCESS_CONFIG[value] ?? ACCESS_CONFIG.public;
  label = cfg.label;
  cls = cfg.cls;
}
---
<span class={`inline-block text-[11px] font-medium px-2.5 py-0.5 rounded-full leading-5 ${cls}`}>
  {label}
</span>
